# ─────────────────────────────────────────────────────────────────────────────
# Ori Agent Service — environment
#
# The environment says where the database is and who may administer the
# service. What the agent can *do* — functions, roles, models, applications —
# lives in the database and is edited through the console at /admin.
#
# You do not have to get this right first time. A missing or wrong value here
# does not stop the service booting: it serves a setup screen at /admin that
# names the step that is outstanding and how to fix it, then re-checks in place.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ──────────────────────────────────────────────────────────────────
PORT=3200
NODE_ENV=development
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3200

# ── Database ─────────────────────────────────────────────────────────────────
# This service has no database of its own. Point it at one you already run and
# it creates its own tables inside it — every one named agent_*, in the schema
# below. Nothing it creates touches a table that was already there.
#
# One database, two connections with different privileges.
#
# DATABASE_URL      the agent's own agent_* tables: registry, conversations,
#                   audit, keys.
# DATABASE_READ_URL the ONLY connection that runs registry functions. It must be
#                   a read-only role or a replica endpoint. The service proves
#                   that it cannot write before it opens the connection, and
#                   refuses to open it at all if it can — that guarantee is what
#                   makes administrator-authored SQL safe to execute.
#
# Creating the read-only role (run once, as an owner):
#   CREATE ROLE ori_reader LOGIN PASSWORD '…';
#   GRANT CONNECT ON DATABASE yourdb TO ori_reader;
#   GRANT USAGE ON SCHEMA public TO ori_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO ori_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO ori_reader;
#   ALTER ROLE ori_reader SET default_transaction_read_only = on;
DATABASE_URL=postgres://ori:ori@localhost:5432/appdb
DATABASE_READ_URL=postgres://ori_reader:secret@localhost:5432/appdb
DATABASE_SCHEMA=ori

DB_POOL_MAX=10
DB_READ_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000
# Local development against a scratch database only. Disables the boot-time
# write assertion; refused outright when NODE_ENV=production.
DB_ALLOW_WRITABLE_READ_POOL=false

# ── Security ─────────────────────────────────────────────────────────────────
# 32 bytes, base64 or hex. Encrypts model provider credentials at rest.
# Generate with:  openssl rand -base64 32
# Changing it makes existing stored credentials unreadable — re-enter them.
ENCRYPTION_KEY=

# The first console account, created only when no account exists. Remove the
# password from the environment once you have signed in and changed it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12

# ── LLM seed ─────────────────────────────────────────────────────────────────
# Used once, on first boot, to create a model row so a fresh deployment works
# before anyone opens the console. After that the models table is authoritative
# and these are ignored. Manage models at /admin → Models.
#
# The seeded model needs tool-calling support: the agent selects functions by
# calling them, not by describing them in JSON. Every hosted provider worth
# using has it, as do vLLM and Ollama for most instruct models.
#
# Knowledge-base embeddings are a *separate* model row with purpose "embedding",
# added in the console rather than seeded — the provider serving your chat model
# frequently cannot embed at all. Leaving it unset is supported: knowledge search
# falls back to keyword-only.
LLM_SEED_BASE_URL=http://localhost:8000/v1
LLM_SEED_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
LLM_SEED_API_KEY=

LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=30000

# ── Behaviour ────────────────────────────────────────────────────────────────
# Disambiguation: if (topScore - secondScore) < this, ask instead of guessing.
DISAMBIGUATION_GAP_THRESHOLD=6
# A top match below this is never trusted outright when rivals exist.
DISAMBIGUATION_MIN_CONFIDENT_SCORE=90
# Short search terms (<= N characters) are held to the stricter score below.
DISAMBIGUATION_SHORT_TERM_LENGTH=3
DISAMBIGUATION_SHORT_TERM_MIN_SCORE=95

DEFAULT_ROW_LIMIT=50
MAX_ROW_LIMIT=200
MAX_CANDIDATES_RETURNED=8
# Functions the model may call within one step of the loop. Note that several
# models — including Groq's gpt-oss-120b — do not support parallel tool calls at
# all and will emit one regardless.
MAX_PLANNED_CALLS=3
# Turns of the agent loop before it gives up. One turn is one model call plus
# its function calls, so this bounds both the latency and the token cost of a
# question. Four covers lookup → act → check, with one spare for a corrected
# retry. Raise it for genuinely multi-part questions; every step is a round trip.
MAX_AGENT_STEPS=4
REGISTRY_CACHE_TTL_MS=30000
RUN_TIMEOUT_MS=120000

# ── Rate limiting (per application + end user) ───────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Outbound (write actions calling back into a host application) ────────────
OUTBOUND_TIMEOUT_MS=10000
# Reserved for future use. Action targets are resolved from the per-application
# service registry, not from this list.
OUTBOUND_ALLOWED_HOSTS=

# An action may declare a `poll` block, for a host API that accepts work and
# finishes it in the background — the agent follows the job and answers with the
# finished thing rather than a job id.
#
# These two bound that waiting, and a function cannot exceed them. The ceiling
# is what a caller is actually made to wait; past it the agent says the work is
# still being prepared, which is true, rather than holding the request open.
OUTBOUND_POLL_MAX_MS=60000
# Floor on a function's poll interval, so a tight loop cannot be authored
# against someone else's API.
OUTBOUND_POLL_MIN_INTERVAL_MS=500
